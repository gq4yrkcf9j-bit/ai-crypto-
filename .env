# === Coinbase API Credentials ===
COINBASE_API_KEY=your_api_key_here
COINBASE_API_SECRET=your_api_secret_here

# === Trading Mode ===
# paper = simulated trades (no real money)
# live  = real trades via Coinbase
TRADING_MODE=paper

# === Trading Pairs (comma-separated in code, but env uses JSON-like list) ===
# Override via CLI: --pairs BTC-USD ETH-USD SOL-USD
TRADING_PAIRS=["BTC-USD","ETH-USD"]

# === Timing ===
SCAN_INTERVAL_SECONDS=60

# === Risk Management ===
MAX_POSITION_PCT=0.02        # Max 2% of wallet per trade
DAILY_LOSS_LIMIT_PCT=0.05    # Kill switch at 5% daily loss
DEFAULT_STOP_LOSS_PCT=0.03   # 3% stop-loss
DEFAULT_TAKE_PROFIT_PCT=0.06 # 6% take-profit

# === Strategy Parameters ===
SHORT_MA_PERIOD=20
LONG_MA_PERIOD=50
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
SENTIMENT_THRESHOLD=0.6

# === Logging ===
DB_PATH=data/trades.db
LOG_LEVEL=INFO
